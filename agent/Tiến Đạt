<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Terror Store - Premium System</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg-base: #f8fafc; --bg-surface: rgba(255,255,255,0.85); --bg-card: rgba(255,255,255,0.95); --bg-elevated: #ffffff;
  --text-main: #0f172a; --text-muted: #64748b; --text-light: #94a3b8;
  --border-color: rgba(15,23,42,0.08); --bg-grid: rgba(15,23,42,0.04);
  --primary: #4f46e5; --secondary: #ec4899; --tertiary: #06b6d4;
  --success: #10b981; --warning: #f59e0b; --danger: #ef4444;
  --glow-opacity: 0.12; --particle-opacity: 0.28;
  --gradient-main: linear-gradient(135deg, var(--primary), var(--tertiary), var(--secondary));
  --gradient-text: linear-gradient(135deg, var(--primary), var(--secondary));
  --shadow-sm: 0 4px 6px -1px rgba(0,0,0,0.05); --shadow-md: 0 10px 15px -3px rgba(0,0,0,0.08);
  --shadow-lg: 0 25px 50px -12px rgba(0,0,0,0.15); --shadow-glow: 0 0 30px -5px rgba(79,70,229,0.4);
  --radius-sm: 12px; --radius-md: 20px; --radius-lg: 32px; --radius-pill: 999px;
}
[data-theme="dark"] {
  --bg-base: #020617; --bg-surface: rgba(15,23,42,0.8); --bg-card: rgba(15,23,42,0.9); --bg-elevated: #1e293b;
  --text-main: #f8fafc; --text-muted: #cbd5e1; --text-light: #64748b;
  --border-color: rgba(255,255,255,0.1); --bg-grid: rgba(255,255,255,0.03);
  --glow-opacity: 0.2; --particle-opacity: 0.58;
  --shadow-sm: 0 4px 6px -1px rgba(0,0,0,0.3); --shadow-md: 0 10px 15px -3px rgba(0,0,0,0.4);
  --shadow-lg: 0 25px 50px -12px rgba(0,0,0,0.6); --shadow-glow: 0 0 30px -5px rgba(139,92,246,0.6);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background-color: var(--bg-base); color: var(--text-main); min-height: 100vh; overflow-x: hidden; line-height: 1.6; transition: background-color 0.4s, color 0.4s; }
a { color: inherit; text-decoration: none; cursor: pointer; }
button { font-family: inherit; cursor: pointer; border: none; outline: none; }
input, select, textarea { font-family: inherit; outline: none; }

.bg-4k-motion { position: fixed; inset: 0; z-index: -2; overflow: hidden; isolation: isolate; background: radial-gradient(ellipse at 50% 0%, rgba(99,102,241,var(--glow-opacity)), transparent 58%), var(--bg-base); transition: background-color 0.4s; pointer-events: none; }
.bg-4k-motion::before, .bg-4k-motion::after { content: ""; position: absolute; inset: -20%; pointer-events: none; }
.bg-4k-motion::before { z-index: -1; background: conic-gradient(from 180deg at 50% 50%, transparent 0deg, rgba(6,182,212,0.13) 70deg, transparent 145deg, rgba(236,72,153,0.12) 245deg, transparent 360deg); filter: blur(48px); animation: auroraDrift 26s ease-in-out infinite alternate; }
.bg-4k-motion::after { z-index: 3; opacity: var(--particle-opacity); background-image: radial-gradient(1.5px 1.5px at 8% 18%, #fff 99%, transparent), radial-gradient(1px 1px at 26% 72%, #a5b4fc 99%, transparent), radial-gradient(2px 2px at 48% 32%, #fff 99%, transparent), radial-gradient(1px 1px at 68% 82%, #67e8f9 99%, transparent), radial-gradient(1.5px 1.5px at 86% 22%, #f0abfc 99%, transparent), radial-gradient(1px 1px at 92% 64%, #fff 99%, transparent); background-size: 380px 340px; animation: particlesDrift 38s linear infinite; }
.bg-particle-canvas { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; opacity: 0.62; }
.bg-4k-shimmer { position: absolute; inset: -60%; z-index: 1; background: linear-gradient(112deg, transparent 48.8%, rgba(103,232,249,0.035) 49.6%, rgba(165,180,252,0.15) 50%, rgba(236,72,153,0.06) 50.25%, transparent 51%); animation: lightSweep 18s ease-in-out infinite; }
.bg-4k-grid { position: absolute; inset: 0; z-index: 1; background-size: 56px 56px; background-image: linear-gradient(to right, var(--bg-grid) 1px, transparent 1px), linear-gradient(to bottom, var(--bg-grid) 1px, transparent 1px); mask-image: linear-gradient(to bottom, black 8%, transparent 92%); animation: gridMove 32s linear infinite; }
.bg-4k-orb { position: absolute; border-radius: 50%; filter: blur(100px); will-change: transform; animation: orbFloat 24s infinite alternate ease-in-out; }
.orb-1 { width: 48vw; height: 48vw; background: var(--primary); top: -22%; left: -12%; opacity: 0.2; }
.orb-2 { width: 56vw; height: 56vw; background: var(--secondary); bottom: -24%; right: -22%; animation-delay: -7s; opacity: 0.16; }
.orb-3 { width: 38vw; height: 38vw; background: var(--tertiary); top: 34%; left: 38%; animation-delay: -13s; opacity: 0.15; }
.bg-4k-ring { position: absolute; z-index: 0; width: min(62vw, 760px); aspect-ratio: 1; border: 1px solid rgba(99,102,241,0.11); border-radius: 50%; left: 50%; top: 48%; transform: translate(-50%,-50%); box-shadow: 0 0 90px rgba(79,70,229,0.07), inset 0 0 90px rgba(6,182,212,0.04); animation: ringPulse 12s ease-in-out infinite alternate; }
.bg-4k-ring.ring-2 { width: min(82vw, 980px); border-color: rgba(6,182,212,0.08); animation-delay: -6s; }
@keyframes gridMove { to { background-position: 56px 56px; } }
@keyframes orbFloat { 0% { transform: translate3d(-2%, -1%, 0) scale(0.94); } 100% { transform: translate3d(9%, 12%, 0) scale(1.08); } }
@keyframes auroraDrift { 0% { transform: translate3d(-3%, -2%, 0) rotate(-8deg) scale(0.95); } 100% { transform: translate3d(4%, 3%, 0) rotate(12deg) scale(1.08); } }
@keyframes particlesDrift { from { background-position: 0 0; } to { background-position: 190px -340px; } }
@keyframes ringPulse { from { opacity: 0.38; scale: 0.96; } to { opacity: 0.9; scale: 1.04; } }
@keyframes lightSweep { 0%, 12% { transform: translate3d(-10%, -5%, 0) rotate(0deg); opacity: 0; } 38% { opacity: 1; } 72% { transform: translate3d(10%, 5%, 0) rotate(0deg); opacity: 0.65; } 100% { transform: translate3d(14%, 8%, 0) rotate(0deg); opacity: 0; } }
@media (max-width: 768px) { .bg-4k-orb { filter: blur(72px); } .bg-4k-ring { width: 88vw; } .bg-4k-ring.ring-2 { width: 112vw; } }
@media (prefers-reduced-motion: reduce) { .bg-4k-motion *, .bg-4k-motion::before, .bg-4k-motion::after { animation: none !important; } }

.reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
.reveal.active { opacity: 1; transform: translateY(0); }
/* Fallback: nếu observer không chạy, vẫn hiện sau 1.5s */
.reveal { animation: revealFallback 0.01s 1.5s forwards; }
@keyframes revealFallback { to { opacity: 1; transform: translateY(0); } }

.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: 20px 0; background: transparent; transition: all 0.4s; }
.navbar.scrolled { padding: 12px 0; background: var(--bg-surface); backdrop-filter: blur(24px); border-bottom: 1px solid var(--border-color); box-shadow: var(--shadow-sm); }
.nav-container { max-width: 1300px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.nav-logo { font-size: 1.6rem; font-weight: 800; background: var(--gradient-text); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.nav-links { display: flex; gap: 4px; background: var(--bg-card); padding: 4px; border-radius: var(--radius-pill); border: 1px solid var(--border-color); }
.nav-links a { padding: 8px 16px; border-radius: var(--radius-pill); font-size: 0.95rem; font-weight: 600; color: var(--text-muted); transition: 0.3s; }
.nav-links a:hover, .nav-links a.active { color: var(--text-main); background: rgba(99,102,241,0.1); }
.nav-user-area { display: flex; align-items: center; gap: 12px; }
.nav-icon-btn { width: auto; min-width: 44px; height: 44px; padding: 0 12px; border-radius: var(--radius-pill); background: linear-gradient(135deg, rgba(255,255,255,0.18), rgba(255,255,255,0.06)); border: 1px solid var(--border-color); color: var(--text-main); font-size: 0.85rem; font-weight: 700; white-space: nowrap; display: flex; align-items: center; justify-content: center; transition: 0.3s; position: relative; box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08); backdrop-filter: blur(16px); }
.nav-icon-btn:hover { border-color: var(--primary); transform: translateY(-2px); box-shadow: 0 15px 30px rgba(79,70,229,0.18); }
.nav-icon-btn:active { transform: scale(0.96); }
.nav-balance { padding: 10px 20px; border-radius: var(--radius-pill); background: var(--gradient-main); color: white; font-size: 0.95rem; font-weight: 700; cursor: pointer; box-shadow: var(--shadow-glow); }
.nav-balance:hover { transform: translateY(-2px); filter: brightness(1.1); }
.nav-avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--bg-elevated); border: 2px solid var(--border-color); display: flex; align-items: center; justify-content: center; font-weight: 800; cursor: pointer; }
.nav-avatar.admin { border-color: var(--warning); color: var(--warning); }
.badge-count { position: absolute; top: -2px; right: -2px; background: var(--danger); color: white; min-width: 20px; height: 20px; border-radius: 10px; font-size: 0.7rem; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 2px solid var(--bg-base); }

.hero { min-height: 90vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 120px 24px 60px; }
.hero-content { max-width: 800px; }
.hero-badge { display: inline-flex; padding: 8px 24px; border-radius: var(--radius-pill); background: var(--bg-card); font-size: 0.95rem; font-weight: 700; margin-bottom: 32px; border: 1px solid var(--border-color); }
.hero h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800; line-height: 1.1; margin-bottom: 24px; }
.hero p { font-size: 1.2rem; color: var(--text-muted); max-width: 600px; margin: 0 auto 40px; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 16px 32px; border-radius: var(--radius-pill); font-size: 1rem; font-weight: 700; transition: 0.3s; cursor: pointer; }
.btn-primary { background: var(--text-main); color: var(--bg-base); }
.btn-primary:hover { transform: translateY(-3px); background: var(--primary); color: white; }
.btn-outline { background: var(--bg-surface); color: var(--text-main); border: 1px solid var(--border-color); }
.btn-outline:hover { transform: translateY(-3px); border-color: var(--text-main); }

.section { padding: 80px 24px; max-width: 1300px; margin: 0 auto; }
.section-header { text-align: center; margin-bottom: 48px; }
.section-header h2 { font-size: 2.5rem; font-weight: 800; margin-bottom: 12px; }
.gradient-text { background: var(--gradient-text); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.category-filters { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
.filter-btn { padding: 12px 24px; border-radius: var(--radius-pill); background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.95rem; font-weight: 700; transition: 0.3s; cursor: pointer; }
.filter-btn:hover { border-color: var(--primary); color: var(--primary); }
.filter-btn.active { background: var(--text-main); color: var(--bg-base); border-color: var(--text-main); }

.products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
.product-card { background: linear-gradient(145deg, color-mix(in srgb, var(--bg-card) 92%, var(--primary)), var(--bg-card) 56%, color-mix(in srgb, var(--bg-card) 94%, var(--tertiary))); border: 1px solid var(--border-color); border-radius: var(--radius-lg); overflow: hidden; transition: 0.3s; display: flex; flex-direction: column; box-shadow: var(--shadow-md); }
.product-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); border-color: var(--primary); }
.product-card.has-background { position: relative; min-height: 560px; background: #08090d; isolation: isolate; }
.product-img { height: auto; aspect-ratio: 1 / 1; background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 48%, #164e63 100%); background-size: cover; background-position: center; background-repeat: no-repeat; display: flex; align-items: center; justify-content: center; font-size: 5rem; position: relative; border-bottom: 1px solid var(--border-color); cursor: pointer; }
.product-img.has-image { isolation: isolate; overflow: hidden; background: linear-gradient(135deg, #0f172a 0%, #1f2937 35%, #1d4ed8 100%); border: 1px solid rgba(255,255,255,0.08); }
.product-card[data-platform="ios"] .product-img, .product-card[data-platform="ios"] .product-img.has-image { background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 48%, #164e63 100%); }
.product-card.has-background .product-img { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; border: 0; z-index: 0; }
.product-card.has-background .product-img::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0.02) 24%, rgba(0,0,0,0.1) 48%, rgba(0,0,0,0.96) 100%); }
.product-image { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; object-fit: cover; object-position: center top; transition: transform 0.5s ease; z-index: 0; }
.product-card:hover .product-image { transform: scale(1.06); }
.product-card.has-background .product-info { position: relative; z-index: 2; flex: 1; justify-content: flex-end; padding: 260px 22px 22px; color: #fff; background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.2) 32%, rgba(0,0,0,0.96) 70%); }
.product-card.has-background .product-platform { color: #a5f3fc; }
.product-card.has-background .product-description { color: rgba(255,255,255,0.86); }
.product-card.has-background .product-rating, .product-card.has-background .product-price-old { color: rgba(255,255,255,0.76); }
.product-card.has-background .product-bottom { border-color: rgba(255,255,255,0.28); }
.product-card.has-background .product-cart-btn { background: rgba(255,255,255,0.16); color: #fff; border-color: rgba(255,255,255,0.34); }
.product-card.has-background .product-buy { color: #111827; background: #fff; }
.product-card.has-background .product-buy:hover:not(:disabled) { color: #fff; background: var(--primary); }
.product-card.has-background .product-badge { z-index: 3; }
.product-icon { position: relative; z-index: 0; }
.product-card[data-platform="ios"] .product-icon { text-shadow: 0 0 26px rgba(103,232,249,0.55); }
.product-card[data-platform="ios"] .product-img:not(.has-image) .product-icon { font-size: 3.2rem; opacity: 0.95; filter: drop-shadow(0 0 12px rgba(103,232,249,0.5)); }
.product-card[data-platform="ios"] .product-img.has-image .product-icon { opacity: 0.2; font-size: 2.8rem; }
.product-detail-visual { position: relative; width: 180px; height: 180px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; border-radius: 16px; background: var(--bg-elevated); font-size: 4rem; }
.product-detail-visual img { width: 100%; height: 100%; object-fit: cover; }
.product-detail-visual .product-icon { position: absolute; }
.product-badge { position: absolute; top: 16px; left: 16px; padding: 6px 14px; border-radius: var(--radius-pill); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; }
.badge-hot { background: var(--secondary); color: white; }
.badge-new { background: var(--primary); color: white; }
.badge-sale { background: var(--warning); color: black; }
.badge-out { background: var(--danger); color: white; }
.product-info { padding: 20px; flex: 1; display: flex; flex-direction: column; }
.product-platform { font-size: 0.8rem; color: var(--primary); font-weight: 800; text-transform: uppercase; margin-bottom: 6px; }
.product-name { font-size: 1.2rem; font-weight: 800; margin-bottom: 8px; }
.product-rating { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px; }
.product-rating .stars { color: var(--warning); }
.product-bottom { display: flex; justify-content: space-between; align-items: flex-end; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border-color); }
.product-price { font-size: 1.4rem; font-weight: 800; }
.product-price-old { font-size: 0.85rem; color: var(--text-light); text-decoration: line-through; }
.product-actions { display: flex; gap: 8px; }
.product-cart-btn { width: 44px; height: 44px; border-radius: var(--radius-md); background: var(--bg-elevated); border: 1px solid var(--border-color); font-size: 1.1rem; cursor: pointer; }
.product-cart-btn:hover:not(:disabled) { background: var(--text-main); color: var(--bg-base); }
.product-buy { padding: 0 20px; height: 44px; border-radius: var(--radius-md); background: var(--text-main); color: var(--bg-base); font-weight: 700; cursor: pointer; }
.product-buy:hover:not(:disabled) { background: var(--primary); color: white; }

/* Feedback */
.feedback-section { padding: 80px 24px; background: var(--bg-surface); }
.feedback-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; max-width: 1300px; margin: 0 auto; }
.feedback-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 20px; display: flex; flex-direction: column; gap: 12px; box-shadow: var(--shadow-sm); }
.feedback-header { display: flex; align-items: center; gap: 12px; }
.feedback-avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--gradient-main); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; }
.feedback-name { font-weight: 800; }
.feedback-time { font-size: 0.8rem; color: var(--text-muted); }
.feedback-stars { color: var(--warning); }
.feedback-text { font-style: italic; }
.feedback-img { width: 100%; max-height: 200px; object-fit: cover; border-radius: var(--radius-sm); }

/* Modal */
.modal-overlay { position: fixed; inset: 0; z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 16px; animation: fadeIn 0.3s; }
.modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); }
.modal-content { position: relative; width: 100%; max-width: 500px; max-height: 90vh; overflow-y: auto; background: var(--bg-card); border-radius: var(--radius-lg); padding: 32px; box-shadow: var(--shadow-lg); z-index: 10; animation: slideUp 0.3s; border: 1px solid var(--border-color); }
.modal-content.wide { max-width: 800px; }
.modal-close { position: absolute; top: 16px; right: 16px; width: 36px; height: 36px; border-radius: 50%; background: var(--bg-elevated); border: 1px solid var(--border-color); font-size: 1.2rem; cursor: pointer; }
.modal-close:hover { background: var(--danger); color: white; }
.modal-title { font-size: 1.6rem; font-weight: 800; margin-bottom: 24px; text-align: center; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

.form-field { margin-bottom: 16px; }
.form-field label { display: block; font-size: 0.85rem; font-weight: 700; margin-bottom: 6px; }
.form-field input, .form-field select, .form-field textarea { width: 100%; padding: 12px 16px; border-radius: var(--radius-md); background: var(--bg-elevated); border: 1px solid var(--border-color); color: var(--text-main); font-size: 0.95rem; }
.form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(79,70,229,0.1); }
.btn-submit { width: 100%; padding: 14px; border-radius: var(--radius-pill); background: var(--text-main); color: var(--bg-base); font-size: 1rem; font-weight: 800; margin-top: 8px; cursor: pointer; }
.btn-submit:hover:not(:disabled) { background: var(--primary); color: white; }
.auth-tabs { display: flex; gap: 6px; background: var(--bg-elevated); padding: 4px; border-radius: var(--radius-pill); margin-bottom: 20px; border: 1px solid var(--border-color); }
.auth-tab { flex: 1; padding: 10px; border-radius: var(--radius-pill); background: transparent; color: var(--text-muted); font-weight: 700; font-size: 0.85rem; cursor: pointer; }
.auth-tab.active { background: var(--bg-card); color: var(--text-main); }

/* Cart Drawer */
.cart-drawer-overlay { position: fixed; inset: 0; z-index: 99998; background: rgba(0,0,0,0.5); display: none; }
.cart-drawer-overlay.open { display: block; }
.cart-drawer { position: fixed; top: 0; right: 0; bottom: 0; width: 420px; max-width: 100vw; background: var(--bg-card); z-index: 99999; display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.3s; border-left: 1px solid var(--border-color); }
.cart-drawer.open { transform: translateX(0); }
.cart-drawer-header { padding: 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; }
.cart-drawer-body { flex: 1; overflow-y: auto; padding: 20px; }
.cart-drawer-footer { padding: 20px; border-top: 1px solid var(--border-color); background: var(--bg-elevated); display: none; }

/* Toast */
.toast-container { position: fixed; top: 24px; right: 24px; z-index: 100000; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
.toast { padding: 14px 20px; background: var(--bg-card); border-radius: var(--radius-md); box-shadow: var(--shadow-lg); display: flex; gap: 12px; align-items: center; border-left: 4px solid var(--primary); animation: toastIn 0.3s; pointer-events: all; }
.toast.success { border-color: var(--success); } .toast.error { border-color: var(--danger); } .toast.warning { border-color: var(--warning); }
@keyframes toastIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

/* Admin */
.admin-page { position: fixed; inset: 0; z-index: 99990; display: none; grid-template-columns: 260px 1fr; background-color: #020617; color: #f8fafc; background-image: radial-gradient(circle at 100% 0%, rgba(99,102,241,0.15) 0%, transparent 50%), radial-gradient(circle at 0% 100%, rgba(236,72,153,0.15) 0%, transparent 50%); }
.admin-page.active { display: grid; }
.admin-sidebar { background: rgba(15,23,42,0.9); backdrop-filter: blur(20px); border-right: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; }
