/* =====================
   SESSION
   ===================== */
const SESSION_IDLE_MS = 30 * 60 * 1000;
let sessionIdleTimer = null;
let lastSessionWriteAt = 0;

function createSession(user) {
  const now = Date.now();
  storage.set(K.SESSION, { userId: user.id, loginAt: now, lastActivityAt: now, token: 'sess_' + uid() });
  lastSessionWriteAt = now;
  scheduleSessionExpiry();
}
function getSession() { return storage.get(K.SESSION, null); }
function clearSession() {
  if (sessionIdleTimer) clearTimeout(sessionIdleTimer);
  sessionIdleTimer = null;
  storage.remove(K.SESSION);
}
function expireSession() {
  if (state.user) revokeUserRemember(state.user.id);
  localStorage.removeItem(K.REMEMBER);
  sessionStorage.removeItem('tst_inventory_admin_token');
  clearSession();
  state.user = null;
  storage.remove(K.USER);
  updateNavUI();
  loadCart();
  showToast('Phiên đăng nhập hết hạn do không hoạt động.', 'warning');
}
function scheduleSessionExpiry() {
  if (sessionIdleTimer) clearTimeout(sessionIdleTimer);
  if (!state.user && !getSession()) return;
  sessionIdleTimer = setTimeout(expireSession, SESSION_IDLE_MS);
}
function recordSessionActivity() {
  const session = getSession();
  if (!session || !state.user) return;
  const now = Date.now();
  if (now - Number(session.lastActivityAt || session.loginAt) >= SESSION_IDLE_MS) {
    expireSession();
    return;
  }
  scheduleSessionExpiry();
  if (now - lastSessionWriteAt >= 60000) {
    session.lastActivityAt = now;
    storage.set(K.SESSION, session);
    lastSessionWriteAt = now;
  }
}
function createRememberToken(userId) {
  const t = storage.get(K.REMEMBER, {});
  const tok = 'rem_' + uid();
  t[tok] = { userId, expiresAt: Date.now() + 30 * 24 * 60 * 60 * 1000 };
  storage.set(K.REMEMBER, t);
  return tok;
}
function validateRememberToken(tok) {
  if (!tok) return null;
  const t = storage.get(K.REMEMBER, {});
  const d = t[tok];
  if (!d) return null;
  if (Date.now() > d.expiresAt) { delete t[tok]; storage.set(K.REMEMBER, t); return null; }
  return d.userId;
}
function revokeUserRemember(userId) {
  const t = storage.get(K.REMEMBER, {});
  Object.keys(t).forEach(k => { if (t[k].userId === userId) delete t[k]; });
  storage.set(K.REMEMBER, t);
}

/* =====================
   AUTH
   ===================== */
function authRegister({ email, password, password2, fullName, acceptTerms }) {
  const e = String(email || '').trim().toLowerCase();
  if (!e) return { ok: false, msg: 'Vui lòng nhập email' };
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)) return { ok: false, msg: 'Email không hợp lệ' };
  if (!fullName || fullName.trim().length < 2) return { ok: false, msg: 'Họ tên tối thiểu 2 ký tự' };
  if (!password || password.length < 6) return { ok: false, msg: 'Mật khẩu tối thiểu 6 ký tự' };
  if (!/[a-zA-Z]/.test(password) || !/[0-9]/.test(password)) return { ok: false, msg: 'Mật khẩu phải có chữ và số' };
  if (password !== password2) return { ok: false, msg: 'Mật khẩu xác nhận không khớp' };
  if (!acceptTerms) return { ok: false, msg: 'Phải đồng ý điều khoản' };
  if (e === ADMIN_EMAIL) return { ok: false, msg: 'Email này dành riêng cho tài khoản quản trị' };
  if (findUserByEmail(e)) return { ok: false, msg: 'Email đã được đăng ký' };
  const u = { id: uid(), email: e, passwordHash: hash(password), fullName: fullName.trim(), balance: 0, role: 'user', status: 'active', failedAttempts: 0, lockedUntil: null, lastLoginAt: null, createdAt: Date.now() };
  saveUser(u);
  logActivity(u.id, 'register', 'Tạo tài khoản');
  return { ok: true, user: u };
}

function authLogin({ email, password, rememberMe }) {
  const e = String(email || '').trim().toLowerCase();
  if (!e) return { ok: false, msg: 'Nhập email' };
  const u = findUserByEmail(e);
  if (!u) return { ok: false, msg: 'Email hoặc mật khẩu không đúng' };
  if (u.status === 'locked') {
    if (u.lockedUntil && Date.now() < u.lockedUntil) return { ok: false, locked: true, msg: 'Tài khoản bị khoá. Thử lại sau ' + Math.ceil((u.lockedUntil - Date.now()) / 60000) + ' phút.' };
    u.status = 'active'; u.lockedUntil = null; u.failedAttempts = 0; saveUser(u);
  }
  if (u.passwordHash !== hash(password)) {
    u.failedAttempts = (u.failedAttempts || 0) + 1;
    if (u.failedAttempts >= 5) {
      u.status = 'locked'; u.lockedUntil = Date.now() + 15 * 60 * 1000; saveUser(u);
      return { ok: false, locked: true, msg: 'Sai 5 lần. Tài khoản bị khoá 15 phút.' };
    }
    saveUser(u);
    return { ok: false, msg: 'Sai mật khẩu. Còn ' + (5 - u.failedAttempts) + ' lần thử.' };
  }
  u.failedAttempts = 0; u.lockedUntil = null; u.status = 'active'; u.lastLoginAt = Date.now(); saveUser(u);
  createSession(u);
  let rememberToken = null;
  if (rememberMe) rememberToken = createRememberToken(u.id);
  logActivity(u.id, 'login', 'Đăng nhập');
  return { ok: true, user: u, rememberToken };
}

function authLogout() {
  if (state.user) revokeUserRemember(state.user.id);
  sessionStorage.removeItem('tst_inventory_admin_token');
  clearSession();
  state.user = null;
  storage.remove(K.USER);
  updateNavUI();
  loadCart();
  showToast('Đã đăng xuất', 'info');
}

function restoreSession() {
  const s = getSession();
  if (s) {
    const lastActivityAt = Number(s.lastActivityAt || s.loginAt);
    if (!lastActivityAt || Date.now() - lastActivityAt >= SESSION_IDLE_MS) {
      clearSession();
      localStorage.removeItem(K.REMEMBER);
    } else {
      const u = findUserById(s.userId);
      if (u && u.status === 'active') {
        state.user = u;
        cacheCurrentUser(u);
        updateNavUI();
        scheduleSessionExpiry();
        return;
      }
      clearSession();
    }
  }
  const tok = localStorage.getItem(K.REMEMBER);
  if (tok) {
    const uid_ = validateRememberToken(tok);
    if (uid_) {
      const u = findUserById(uid_);
      if (u && u.status === 'active') { state.user = u; cacheCurrentUser(u); createSession(u); updateNavUI(); return; }
    }
    localStorage.removeItem(K.REMEMBER);
  }
  cacheCurrentUser(null);
}

/* =====================
   TOPUP
   ===================== */
function createTopupRequest({ userId, amount, method, note }) {
  const reqs = getTopupReqs();
  const req = { id: uid(), userId, amount, method, note: note || '', status: 'pending', createdAt: Date.now(), reviewedAt: null, reviewedBy: null };
  reqs.unshift(req);
  storage.set(K.TOPUP, reqs);
  return req;
}
function approveTopupRequest(reqId, adminEmail) {
  const reqs = getTopupReqs();
  const req = reqs.find(r => r.id === reqId);
  if (!req || req.status !== 'pending') return { ok: false, msg: 'Request không hợp lệ' };
  const u = findUserById(req.userId);
  if (!u) return { ok: false, msg: 'Không tìm thấy user' };
  u.balance += req.amount; saveUser(u);
  req.status = 'approved'; req.reviewedAt = Date.now(); req.reviewedBy = adminEmail;
  storage.set(K.TOPUP, reqs);
  addTx({ type: 'topup', amount: req.amount, desc: 'Nạp qua ' + (req.method === 'vietqr' ? 'VietQR' : 'thẻ cào') + ' (Admin duyệt)', userId: req.userId });
  logActivity(req.userId, 'topup', 'Nạp ' + fmt(req.amount));
  if (state.user && state.user.id === u.id) { state.user = u; cacheCurrentUser(u); updateNavUI(); }
  return { ok: true };
}
function rejectTopupRequest(reqId, adminEmail, reason = '') {
  const reqs = getTopupReqs();
  const req = reqs.find(r => r.id === reqId);
  if (!req || req.status !== 'pending') return { ok: false, msg: 'Request không hợp lệ' };
  req.status = 'rejected'; req.reviewedAt = Date.now(); req.reviewedBy = adminEmail;
  storage.set(K.TOPUP, reqs);
  logActivity(req.userId, 'topup_reject', 'Nạp ' + fmt(req.amount) + ' bị từ chối');
  return { ok: true };
}
function adminAdjustBalance(userId, amount, reason, adminEmail) {
  const u = findUserById(userId);
  if (!u) return { ok: false, msg: 'User không tồn tại' };
  if (!state.user || state.user.role !== 'admin') return { ok: false, msg: 'Không có quyền quản trị' };
  if (u.role === 'admin' || String(u.email).toLowerCase() === ADMIN_EMAIL) return { ok: false, msg: 'Không thể chỉnh số dư tài khoản quản trị' };
  if (!Number.isSafeInteger(amount) || amount === 0) return { ok: false, msg: 'Số tiền không hợp lệ' };
  if (!Number.isSafeInteger(u.balance + amount)) return { ok: false, msg: 'Số dư vượt giới hạn cho phép' };
  if (amount < 0 && u.balance + amount < 0) return { ok: false, msg: 'Số dư không đủ' };
  const before = u.balance;
  u.balance += amount; saveUser(u);
  addTx({ type: amount > 0 ? 'admin_add' : 'admin_subtract', amount, desc: (amount > 0 ? 'Admin cộng' : 'Admin trừ') + ': ' + reason + ' (' + fmt(before) + '→' + fmt(u.balance) + ')', userId });
  logActivity(userId, amount > 0 ? 'admin_add' : 'admin_subtract', 'Admin ' + (amount > 0 ? 'cộng' : 'trừ') + ' ' + fmt(Math.abs(amount)));
  if (state.user && state.user.id === u.id) { state.user = u; cacheCurrentUser(u); updateNavUI(); }
  return { ok: true };
}

/* =====================
