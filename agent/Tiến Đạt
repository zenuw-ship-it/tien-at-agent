function enablePasswordVisibility(root) {
  root.querySelectorAll('input[type="password"]').forEach(input => {
    const wrapper = document.createElement('div');
    wrapper.style.position = 'relative';
    wrapper.style.width = '100%';
    input.parentNode.insertBefore(wrapper, input);
    wrapper.appendChild(input);
    input.style.paddingRight = '68px';

    const toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.textContent = 'Hiện';
    toggle.setAttribute('aria-label', 'Hiện mật khẩu');
    toggle.setAttribute('aria-pressed', 'false');
    Object.assign(toggle.style, {
      position: 'absolute', right: '10px', top: '50%', transform: 'translateY(-50%)',
      border: '0', background: 'transparent', color: 'var(--primary)',
      fontWeight: '700', cursor: 'pointer', padding: '8px', fontSize: '0.8rem'
    });
    toggle.onclick = () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      toggle.textContent = show ? 'Ẩn' : 'Hiện';
      toggle.setAttribute('aria-label', (show ? 'Ẩn' : 'Hiện') + ' mật khẩu');
      toggle.setAttribute('aria-pressed', String(show));
    };
    wrapper.appendChild(toggle);
  });
}

function openModal(title, bodyHtml, wide = false) {
  const old = document.querySelector('.modal-overlay');
