function toggleTheme() {
  const cur = document.documentElement.getAttribute('data-theme') || 'light';
  const next = cur === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  storage.set(K.THEME, next);
}
function loadTheme() {
  const t = storage.get(K.THEME, 'light');
  document.documentElement.setAttribute('data-theme', t);
}

/* =====================
   DATA ACCESS
   ===================== */
function getUsers() { return storage.get(K.USERS, []); }
function saveUsers(u) { storage.set(K.USERS, u); }
function findUserByEmail(e) { return getUsers().find(u => u.email === String(e).toLowerCase().trim()); }
function findUserById(id) { return getUsers().find(u => u.id === id); }
function cacheCurrentUser(user) {
  if (!user) { storage.remove(K.USER); return; }
  const { id, email, fullName, balance, role, status } = user;
  storage.set(K.USER, { id, email, fullName, balance, role, status });
}
function saveUser(u) {
  delete u.rawPassword;
  const arr = getUsers(); const i = arr.findIndex(x => x.id === u.id);
  u.updatedAt = Date.now();
  if (i >= 0) arr[i] = u; else arr.push(u);
  saveUsers(arr);
}
function logActivity(userId, type, text) {
  const l = storage.get(K.ACTIVITY, {});
  if (!l[userId]) l[userId] = [];
  l[userId].unshift({ type, text, ts: Date.now() });
  l[userId] = l[userId].slice(0, 50);
  storage.set(K.ACTIVITY, l);
}
function getActivity(userId) { const l = storage.get(K.ACTIVITY, {}); return l[userId] || []; }
function addTx(obj) { const txs = storage.get(K.TX, []); obj.id = uid(); obj.createdAt = Date.now(); txs.unshift(obj); storage.set(K.TX, txs.slice(0, 500)); }
function getOrders() { return storage.get(K.ORDERS, []); }
function getTxs() { return storage.get(K.TX, []); }
function getTopupReqs() { return storage.get(K.TOPUP, []); }
function getWishlist() { if (!state.user) return []; return storage.get(K.WISH, {})[state.user.id] || []; }
function saveWishlist(list) { if (!state.user) return; const all = storage.get(K.WISH, {}); all[state.user.id] = list; storage.set(K.WISH, all); }
function getFeedbacks() { return storage.get(K.FEEDBACK, []); }
function getCoupons() { return storage.get(K.COUPONS, []); }
function saveCoupons(coupons) { storage.set(K.COUPONS, coupons); }
function saveFeedback(fb) { const arr = getFeedbacks(); arr.unshift(fb); storage.set(K.FEEDBACK, arr.slice(0, 100)); renderFeedbacks(); }
function deleteFeedback(id) { const arr = getFeedbacks().filter(fb => fb.id !== id); storage.set(K.FEEDBACK, arr); renderFeedbacks(); }

