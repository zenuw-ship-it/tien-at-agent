const INVENTORY_TOKEN_KEY = 'tst_inventory_admin_token';

async function connectAdminInventory() {
  if (!state.user || state.user.role !== 'admin') { showToast('Không có quyền quản trị', 'error'); return; }
  const tokenInput = document.getElementById('inventoryAdminToken');
  const token = tokenInput.value.trim();
  if (!token) { showToast('Nhập khóa API quản trị', 'warning'); return; }
  try {
    const response = await fetch('/api/admin/products', { headers: { Authorization: 'Bearer ' + token } });
    const result = await response.json();
    if (!response.ok || !result.success) throw new Error(result.message || 'Không thể kết nối kho.');
    sessionStorage.setItem(INVENTORY_TOKEN_KEY, token);
    applyInventoryData(result.products);
    renderAdminInventory(result.products);
    document.getElementById('inventoryAdminMessage').textContent = 'Đã kết nối kho backend.';
    document.getElementById('inventoryAdminMessage').style.color = 'var(--success)';
  } catch (error) {
    sessionStorage.removeItem(INVENTORY_TOKEN_KEY);
    document.getElementById('inventoryAdminMessage').textContent = error.message || 'Không kết nối được backend.';
    document.getElementById('inventoryAdminMessage').style.color = 'var(--danger)';
  }
}

function renderAdminInventory(products) {
  const token = sessionStorage.getItem(INVENTORY_TOKEN_KEY);
  const input = document.getElementById('inventoryAdminToken');
  if (input && !input.value && token) input.value = token;
  if (products) {
    document.getElementById('inventoryTableBody').innerHTML = products.map(product => '<tr><td>' + esc(product.name) + '</td><td>' + fmt(product.price) + '</td><td><input type="number" min="0" step="1" id="inventoryStock_' + product.id + '" value="' + product.stock + '" style="width:90px;"></td><td><input type="number" min="0" step="1" id="inventorySold_' + product.id + '" value="' + product.sold + '" style="width:90px;"></td><td><button class="btn-sm success" type="button" onclick="adminSaveInventory(' + product.id + ')">Lưu</button></td></tr>').join('');
    return;
  }
  if (!token) return;
  fetch('/api/admin/products', { headers: { Authorization: 'Bearer ' + token } })
    .then(async response => {
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.message || 'Không thể tải kho.');
      applyInventoryData(result.products);
      renderAdminInventory(result.products);
    })
    .catch(error => {
      document.getElementById('inventoryAdminMessage').textContent = error.message;
      document.getElementById('inventoryAdminMessage').style.color = 'var(--danger)';
    });
}

function applyInventoryData(products) {
  products.forEach(inventoryItem => {
    const product = state.products.find(item => item.id === inventoryItem.id);
    if (product) {
      product.stock = inventoryItem.stock;
      product.sold = inventoryItem.sold;
    }
  });
  renderProducts();
}

window.adminSaveInventory = async function(productId) {
  if (!state.user || state.user.role !== 'admin') { showToast('Không có quyền quản trị', 'error'); return; }
  const token = sessionStorage.getItem(INVENTORY_TOKEN_KEY);
  if (!token) { showToast('Kết nối kho bằng khóa API trước', 'warning'); return; }
  const stock = Number(document.getElementById('inventoryStock_' + productId).value);
  const sold = Number(document.getElementById('inventorySold_' + productId).value);
  if (!Number.isSafeInteger(stock) || stock < 0 || !Number.isSafeInteger(sold) || sold < 0) {
    showToast('Tồn kho và số đã bán phải là số nguyên không âm', 'error');
    return;
  }
  try {
    const response = await fetch('/api/admin/update-product', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ productId, stock, sold })
    });
    const result = await response.json();
    if (!response.ok || !result.success) throw new Error(result.message || 'Không thể cập nhật kho.');
    applyInventoryData(result.products);
    renderAdminInventory(result.products);
    document.getElementById('inventoryAdminMessage').textContent = result.message;
    document.getElementById('inventoryAdminMessage').style.color = 'var(--success)';
  } catch (error) {
    document.getElementById('inventoryAdminMessage').textContent = error.message;
    document.getElementById('inventoryAdminMessage').style.color = 'var(--danger)';
  }
};

