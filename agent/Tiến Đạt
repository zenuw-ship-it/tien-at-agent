function getFeaturedProduct() {
  return [...state.products].sort((a, b) => (b.sold * b.price) - (a.sold * a.price))[0] || null;
}

function renderFeaturedProduct() {
  const featured = getFeaturedProduct();
  const img = document.querySelector('.hero-showcase-card img');
  const title = document.querySelector('.hero-showcase-caption strong');
  const sub = document.querySelector('.hero-showcase-caption span');
  if (!featured || !img || !title || !sub) return;
  img.hidden = false;
  img.onerror = () => { img.style.display = 'none'; };
  img.src = featured.image || 'AimLock Vip.jpg';
  img.alt = featured.name;
  title.textContent = featured.name;
  sub.textContent = 'Doanh thu cao nhất';
}

function renderProducts() {
  const g = document.getElementById('mainProductsGrid');
  if (!g) return;
  let p = [...state.products];
  if (state.filter !== 'all') p = p.filter(x => x.platform === state.filter);
  if (p.length === 0) { g.innerHTML = '<p style="text-align:center; grid-column:1/-1; padding:40px;">Không có sản phẩm</p>'; return; }
  g.innerHTML = p.map(i => {
    const out = i.stock <= 0;
    const imageStyle = i.image ? ' style="background-image:url(&quot;' + esc(i.image) + '&quot;)"' : '';
    return '<div class="product-card' + (i.image ? ' has-background' : '') + '" data-platform="' + esc(i.platform) + '"><div class="product-img' + (i.image ? ' has-image' : '') + '"' + imageStyle + ' role="button" tabindex="0" aria-label="Xem chi tiết ' + esc(i.name) + '" onclick="openProductDetail(' + i.id + ')"><span class="product-icon">' + esc(i.icon) + '</span>' + (i.image ? '<img class="product-image" src="' + esc(i.image) + '" alt="' + esc(i.name) + '" loading="lazy">' : '') + (out ? '<span class="product-badge badge-out">HẾT</span>' : (i.badge ? '<span class="product-badge badge-' + i.badge + '">' + i.badge.toUpperCase() + '</span>' : '')) + '</div><div class="product-info"><div class="product-platform">' + esc(i.platform) + '</div><div class="product-name">' + esc(i.name) + '</div><p class="product-description">' + esc(i.desc || i.features.join(' · ')) + '</p><div class="product-rating"><span class="stars">' + '★'.repeat(i.rating) + '☆'.repeat(5 - i.rating) + '</span><span>(' + i.sold + ' đã bán)</span></div><div class="product-bottom"><div><div class="product-price-old">' + (i.oldPrice ? fmt(i.oldPrice) : '') + '</div><div class="product-price">' + fmt(i.price) + '</div></div><div class="product-actions"><button class="product-cart-btn" onclick="addToCart(' + i.id + ')" ' + (out ? 'disabled' : '') + '>🛒</button><button class="product-buy" onclick="addToCart(' + i.id + '); openCartDrawer()" ' + (out ? 'disabled' : '') + '>' + (out ? 'HẾT' : 'MUA') + '</button></div></div></div></div>';
  }).join('');
  g.querySelectorAll('.product-img[role="button"]').forEach(frame => {
    frame.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        frame.click();
      }
    });
  });
  g.querySelectorAll('.product-image').forEach(img => {
    img.addEventListener('error', () => {
      const frame = img.closest('.product-img');
      if (frame) {
        frame.classList.remove('has-image');
        frame.style.backgroundImage = '';
        const card = frame.closest('.product-card');
        if (card) card.classList.remove('has-background');
      }
      img.remove();
      const icon = frame && frame.querySelector('.product-icon');
      if (icon) { icon.style.opacity = '1'; icon.style.position = 'relative'; }
    }, { once: true });
  });
  renderFeaturedProduct();
}

