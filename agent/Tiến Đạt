        state.user = null;
        clearSession();
        storage.remove(K.USER);
        closeAdminPage();
        updateNavUI();
        showToast('Tài khoản đã bị khóa hoặc xóa', 'warning');
      }
    }
    if (state.adminView === 'users' && document.getElementById('adminPage').classList.contains('active')) renderAdminUsers();
  }
  if (e.key === K.TOPUP) { updateTopupBadge(); if (state.adminView === 'topup' && document.getElementById('adminPage').classList.contains('active')) renderAdminTopup(); }
  if (e.key === K.FEEDBACK) renderFeedbacks();
});

['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(eventName => {
  document.addEventListener(eventName, recordSessionActivity, { passive: true });
});
window.addEventListener('focus', recordSessionActivity);

window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

/* =====================
   KHỞI TẠO (ĐÃ SỬA - bọc try/catch từng bước để không "chết dây chuyền")
   ===================== */
loadTheme();
try { initAdminAccount(); } catch (e) { console.error('initAdminAccount:', e); }
try { seedDefaultFeedbacks(); } catch (e) { console.error('seedDefaultFeedbacks:', e); }
try { initBackgroundMotion(); } catch (e) { console.error('initBackgroundMotion:', e); }
try { restoreSession(); } catch (e) { console.error('restoreSession:', e); }
try { loadCart(); } catch (e) { console.error('loadCart:', e); }
try { renderProducts(); } catch (e) { console.error('renderProducts:', e); }
try { loadServerInventory(); } catch (e) { console.error('loadServerInventory:', e); }
try { renderFeedbacks(); } catch (e) { console.error('renderFeedbacks:', e); }
try { renderFeaturedProduct(); } catch (e) { console.error('renderFeaturedProduct:', e); }
setTimeout(() => { try { initReveal(); } catch (e) { console.error('initReveal:', e); } }, 200);
</script>
