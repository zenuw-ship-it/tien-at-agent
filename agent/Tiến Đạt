function loadCart() { state.cart = storage.get(K.CART, []); updateCartUI(); renderCartDrawer(); }
function saveCart() { storage.set(K.CART, state.cart); updateCartUI(); renderCartDrawer(); }
function updateCartUI() {
  const c = state.cart.reduce((s, i) => s + i.qty, 0);
  const b = document.getElementById('cartBadge');
  if (c > 0) { b.style.display = 'flex'; b.textContent = c; } else b.style.display = 'none';
}
function addToCart(pid) {
  if (!state.user) { showToast('Đăng nhập để thêm giỏ', 'warning'); openAuthModal(); return; }
  const p = state.products.find(x => x.id === pid);
  if (!p || p.stock <= 0) { showToast('Hết hàng', 'error'); return; }
  const ex = state.cart.find(i => i.id === pid);
  if (ex) { if (ex.qty + 1 > p.stock) { showToast('Chỉ còn ' + p.stock, 'warning'); return; } ex.qty++; }
  else state.cart.push({ id: pid, qty: 1 });
  saveCart(); showToast('Đã thêm ' + p.name, 'success');
}
function removeFromCart(pid) { state.cart = state.cart.filter(i => i.id !== pid); saveCart(); }
function updateCartQty(pid, d) {
  const i = state.cart.find(x => x.id === pid); if (!i) return;
  const p = state.products.find(x => x.id === pid);
  i.qty += d;
  if (i.qty <= 0) removeFromCart(pid);
  else if (i.qty > p.stock) { i.qty = p.stock; showToast('Đạt giới hạn', 'warning'); saveCart(); }
  else saveCart();
}
function openCartDrawer() { document.getElementById('cartOverlay').classList.add('open'); document.getElementById('cartDrawer').classList.add('open'); renderCartDrawer(); }
function closeCartDrawer() { document.getElementById('cartOverlay').classList.remove('open'); document.getElementById('cartDrawer').classList.remove('open'); }
function getCartTotals() {
  const subtotal = state.cart.reduce((sum, item) => {
    const product = state.products.find(product => product.id === item.id);
    return sum + (product ? product.price * item.qty : 0);
  }, 0);
  const coupon = state.couponCode ? getCoupons().find(item => item.code === state.couponCode && item.active) : null;
  if (state.couponCode && !coupon) state.couponCode = null;
  const discount = coupon ? Math.floor(subtotal * coupon.percent / 100) : 0;
  return { subtotal, discount, total: subtotal - discount, coupon };
}
