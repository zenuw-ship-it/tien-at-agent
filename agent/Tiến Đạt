function renderAdminRevenueChart(range) {
  if (range !== 'hourly' && range !== 'daily') return;
  const chart = document.getElementById('revenueChart');
  if (!chart) return;
  const now = new Date();
  const hourly = range === 'hourly';
  const count = hourly ? 24 : 7;
  const start = new Date(now);
  if (hourly) {
    start.setMinutes(0, 0, 0);
    start.setHours(start.getHours() - (count - 1));
  } else {
    start.setHours(0, 0, 0, 0);
    start.setDate(start.getDate() - (count - 1));
  }
  const step = hourly ? 60 * 60 * 1000 : 24 * 60 * 60 * 1000;
  const buckets = Array.from({ length: count }, (_, index) => ({
    date: new Date(start.getTime() + index * step),
    value: 0
  }));
  getOrders().forEach(order => {
    const createdAt = Number(order.createdAt);
    const amount = Number(order.total);
    if (!Number.isFinite(createdAt) || !Number.isFinite(amount) || amount <= 0 || (order.status && order.status !== 'paid')) return;
    const timestamp = new Date(createdAt);
    let index;
    if (hourly) {
      index = Math.floor((timestamp.getTime() - start.getTime()) / step);
    } else {
      const day = new Date(timestamp);
      day.setHours(0, 0, 0, 0);
      index = Math.round((day.getTime() - start.getTime()) / step);
    }
    if (index >= 0 && index < buckets.length) buckets[index].value += amount;
  });
  const total = buckets.reduce((sum, bucket) => sum + bucket.value, 0);
  document.getElementById('revenueChartSubtitle').textContent = hourly ? 'Theo giờ trong 24 giờ qua' : 'Theo ngày trong 7 ngày qua';
  document.getElementById('revenueChartTotal').textContent = fmt(total);
  document.getElementById('revenueChartTotalLabel').textContent = hourly ? 'Tổng doanh thu 24 giờ qua' : 'Tổng doanh thu 7 ngày qua';
  document.querySelectorAll('[data-revenue-range]').forEach(button => button.classList.toggle('active', button.dataset.revenueRange === range));
  if (total === 0) {
    chart.innerHTML = '<div class="revenue-empty">Chưa có đơn hàng thành công trong khoảng thời gian này.</div>';
    return;
  }

  const left = 64, right = 884, top = 22, bottom = 244;
  const maxValue = Math.max(...buckets.map(bucket => bucket.value));
  const scaleMax = Math.max(1000, Math.ceil(maxValue / 4 / 1000) * 1000);
  const x = index => left + index * (right - left) / (count - 1);
  const y = value => bottom - value * (bottom - top) / scaleMax;
  const points = buckets.map((bucket, index) => ({ x: x(index), y: y(bucket.value), bucket }));
  const linePath = points.map((point, index) => (index ? 'L' : 'M') + point.x.toFixed(1) + ' ' + point.y.toFixed(1)).join(' ');
  const areaPath = linePath + ' L' + right + ' ' + bottom + ' L' + left + ' ' + bottom + ' Z';
  const grid = Array.from({ length: 5 }, (_, index) => {
    const value = scaleMax * (4 - index) / 4;
    const gridY = top + index * (bottom - top) / 4;
    return '<line class="chart-grid" x1="' + left + '" y1="' + gridY + '" x2="' + right + '" y2="' + gridY + '"></line><text x="' + (left - 10) + '" y="' + (gridY + 4) + '" text-anchor="end">' + (value >= 1000000 ? (value / 1000000).toFixed(value % 1000000 ? 1 : 0) + 'tr' : Math.round(value / 1000) + 'k') + '</text>';
  }).join('');
  const labelIndexes = hourly ? [0, 3, 6, 9, 12, 15, 18, 21, 23] : buckets.map((_, index) => index);
  const labels = labelIndexes.map(index => {
    const date = buckets[index].date;
    const label = hourly
      ? new Intl.DateTimeFormat('vi-VN', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(date)
      : new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit' }).format(date);
    return '<text x="' + x(index).toFixed(1) + '" y="' + (bottom + 24) + '" text-anchor="middle">' + label + '</text>';
  }).join('');
  const circles = points.map(point => {
    const label = hourly
      ? new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(point.bucket.date)
      : new Intl.DateTimeFormat('vi-VN', { dateStyle: 'full' }).format(point.bucket.date);
    return '<circle class="chart-point" cx="' + point.x.toFixed(1) + '" cy="' + point.y.toFixed(1) + '" r="4"><title>' + label + ': ' + fmt(point.bucket.value) + '</title></circle>';
  }).join('');
  chart.innerHTML = '<svg class="revenue-chart" viewBox="0 0 900 286" role="img" aria-label="Biểu đồ doanh thu ' + (hourly ? 'theo giờ' : 'theo ngày') + '"><defs><linearGradient id="revenueArea" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#22d3ee" stop-opacity=".28"></stop><stop offset="100%" stop-color="#22d3ee" stop-opacity="0"></stop></linearGradient></defs>' + grid + '<path d="' + areaPath + '" fill="url(#revenueArea)"></path><path class="chart-line" d="' + linePath + '"></path>' + circles + labels + '</svg>';
}

