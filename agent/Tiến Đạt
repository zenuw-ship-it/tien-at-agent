   ===================== */
function fmt(n) { return new Intl.NumberFormat('vi-VN').format(n) + 'đ'; }
function esc(s) { return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
function orderCode() { return 'TST' + Date.now().toString().slice(-8).toUpperCase(); }
function timeAgo(ts) { const d = Date.now() - ts, m = Math.floor(d/60000); if(m<1) return 'Vừa xong'; if(m<60) return m+' phút trước'; const h=Math.floor(m/60); if(h<24) return h+' giờ trước'; return Math.floor(h/24)+' ngày trước'; }
function fmtFull(ts) { return new Date(ts).toLocaleString('vi-VN'); }
function hash(s) { let h = 0; const salt = 'tst_' + s + '_salt_2026'; for (let i = 0; i < salt.length; i++) { h = ((h << 5) - h) + salt.charCodeAt(i); h = h & h; } return 'h_' + Math.abs(h).toString(36) + '_' + btoa(s.slice(0, 8)).replace(/=/g, ''); }

/* =====================
