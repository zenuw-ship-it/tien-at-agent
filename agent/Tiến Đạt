.bg-4k-orb { filter: blur(84px) saturate(1.5); }
.orb-1 { opacity: 0.29; }
.orb-2 { opacity: 0.25; }
.orb-3 { opacity: 0.24; }
.bg-4k-ring { border-color: rgba(129,140,248,0.2); box-shadow: 0 0 110px rgba(79,70,229,0.14), inset 0 0 100px rgba(6,182,212,0.08); }
.bg-4k-ring.ring-2 { border-color: rgba(236,72,153,0.13); }
.bg-4k-shimmer { background: linear-gradient(112deg, transparent 47.8%, rgba(103,232,249,0.08) 49.4%, rgba(196,181,253,0.27) 50%, rgba(244,114,182,0.13) 50.35%, transparent 52%); animation-duration: 13s; }
.hero::before { background: radial-gradient(circle at 35% 35%, rgba(99,102,241,0.26), rgba(6,182,212,0.13) 38%, rgba(236,72,153,0.1) 54%, transparent 72%); animation: heroGlow 10s ease-in-out infinite alternate; }
.hero-showcase-orbit { border-color: rgba(129,140,248,0.35); box-shadow: 0 0 100px rgba(79,70,229,0.25), inset 0 0 90px rgba(6,182,212,0.13); }
@keyframes heroGlow { from { transform: scale(0.92) translate3d(-2%,0,0); opacity: 0.65; } to { transform: scale(1.08) translate3d(2%,2%,0); opacity: 1; } }

button, a.btn, .nav-balance, .admin-nav-item, .filter-btn, .menu-item {
