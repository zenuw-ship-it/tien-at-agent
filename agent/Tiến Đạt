/* High-energy color and consistent controls */
.bg-4k-motion {
  background:
    radial-gradient(ellipse at 12% 18%, rgba(79,70,229,0.27), transparent 38%),
    radial-gradient(ellipse at 86% 22%, rgba(236,72,153,0.2), transparent 36%),
    radial-gradient(ellipse at 50% 88%, rgba(6,182,212,0.18), transparent 42%),
    radial-gradient(ellipse at 50% 0%, rgba(99,102,241,var(--glow-opacity)), transparent 58%),
    var(--bg-base);
}
[data-theme="dark"] .bg-4k-motion {
  background:
    radial-gradient(ellipse at 12% 18%, rgba(79,70,229,0.35), transparent 38%),
    radial-gradient(ellipse at 86% 22%, rgba(236,72,153,0.26), transparent 36%),
    radial-gradient(ellipse at 50% 88%, rgba(6,182,212,0.24), transparent 42%),
    var(--bg-base);
}
.bg-4k-motion::before {
  background: conic-gradient(from 180deg at 50% 50%, transparent 0deg, rgba(6,182,212,0.22) 54deg, transparent 128deg, rgba(236,72,153,0.2) 220deg, transparent 292deg, rgba(129,140,248,0.15) 330deg, transparent 360deg);
  filter: blur(40px) saturate(1.45);
