.hero-showcase-card { position: relative; width: min(78%, 370px); aspect-ratio: 0.86; padding: 12px; border: 1px solid rgba(255,255,255,0.24); border-radius: 28px; background: linear-gradient(145deg, rgba(255,255,255,0.17), rgba(255,255,255,0.04)); box-shadow: 0 35px 100px rgba(0,0,0,0.3), 0 0 70px rgba(79,70,229,0.2); backdrop-filter: blur(16px); transform: rotateY(-8deg) rotateX(3deg); animation: showcaseFloat 7s ease-in-out infinite; }
